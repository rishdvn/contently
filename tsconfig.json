{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  /* `workers/` and `packages/` are Node services and packages with their own
     compiler settings and their own `npm run check`; typechecking them against
     the browser's libs here would ask them to be something they are not. The
     render scripts import the worker and run under its `tsx`, so they are
     checked with it too. */
  "exclude": ["node_modules", "workers", "packages", "scripts/lib/stage.ts", "scripts/block-previews.ts", "scripts/template-posters.ts"]
}
